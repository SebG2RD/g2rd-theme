<?xml version="1.0"?>
<ruleset name="G2RD Theme">
    <description>Regles PHPCS pour le theme G2RD (WordPress + Security)</description>

    <!-- Chemins a scanner -->
    <file>./classes</file>
    <file>./functions.php</file>
    <file>./includes</file>
    <file>./index.php</file>

    <!-- Chemins a ignorer -->
    <exclude-pattern>./vendor/*</exclude-pattern>
    <exclude-pattern>./node_modules/*</exclude-pattern>
    <exclude-pattern>./blocks/*/build/*</exclude-pattern>
    <exclude-pattern>./blocks/*/src/*</exclude-pattern>
    <exclude-pattern>./blocks/*/*.php</exclude-pattern>
    <exclude-pattern>./assets/js/vendor/*</exclude-pattern>

    <!-- Extensions PHP -->
    <arg name="extensions" value="php"/>
    <arg name="colors"/>
    <arg value="ps"/>

    <!-- WordPress Coding Standards -->
    <rule ref="WordPress">

        <!-- ── Noms de fichiers ──────────────────────────────────────────── -->
        <!-- Les classes utilisent PascalCase/underscores (ex. class-theme-setup.php) -->
        <exclude name="WordPress.Files.FileName.NotHyphenatedLowercase"/>
        <exclude name="WordPress.Files.FileName.InvalidClassFileName"/>

        <!-- ── Noms de méthodes ──────────────────────────────────────────── -->
        <!--
            Le projet utilise camelCase (héritage PSR-2).
            À migrer progressivement vers snake_case via refactoring dédié.
        -->
        <exclude name="WordPress.NamingConventions.ValidFunctionName.MethodNameInvalid"/>

        <!-- ── Tableaux ──────────────────────────────────────────────────── -->
        <!--
            Alignement des double-flèches : désactivé pour les tableaux complexes
            (Abilities API) qui utilisent une indentation fonctionnelle.
        -->
        <exclude name="WordPress.Arrays.MultipleStatementAlignment"/>

        <!--
            Syntaxe courte [] autorisée — projet PHP 8.0+.
            WPCS 2.x : Generic.Arrays.DisallowShortArraySyntax
            WPCS 3.x : Universal.Arrays.DisallowShortArraySyntax (PHPCSExtra)
        -->
        <exclude name="Generic.Arrays.DisallowShortArraySyntax"/>
        <exclude name="Universal.Arrays.DisallowShortArraySyntax"/>

        <!--
            Espacement des accolades d'array sur une seule ligne.
            NormalizedArrays est inclus dans WPCS 3.x via PHPCSExtra — pas présent en 2.x.
        -->
        <exclude name="NormalizedArrays.Arrays.ArrayBraceSpacing"/>

        <!--
            Virgule finale dans les tableaux multi-lignes.
            NormalizedArrays est inclus dans WPCS 3.x via PHPCSExtra — pas présent en 2.x.
        -->
        <exclude name="NormalizedArrays.Arrays.CommaAfterLast"/>

        <!-- ── Espacement des appels de fonctions ────────────────────────── -->
        <!--
            Le projet utilise le style PSR-2 : func('arg') sans espace interne.
            WPCS 2.x : WordPress.WhiteSpace.FunctionCallSignature (supprimé en 3.x)
            WPCS 3.x : ces sniffs PEAR remplacent le précédent
        -->
        <exclude name="PEAR.Functions.FunctionCallSignature.SpaceAfterOpenBracket"/>
        <exclude name="PEAR.Functions.FunctionCallSignature.SpaceBeforeCloseBracket"/>
        <exclude name="PEAR.Functions.FunctionCallSignature.NoSpaceBeforeOpenBracket"/>
        <exclude name="PEAR.Functions.FunctionCallSignature.MultipleArguments"/>
        <exclude name="PEAR.Functions.FunctionCallSignature.ContentAfterOpenBracket"/>
        <exclude name="PEAR.Functions.FunctionCallSignature.CloseBracketLine"/>

        <!-- Idem pour les déclarations de fonctions (paramètres) -->
        <exclude name="Squiz.Functions.FunctionDeclarationArgumentSpacing.SpacingAfterOpen"/>
        <exclude name="Squiz.Functions.FunctionDeclarationArgumentSpacing.SpacingBeforeClose"/>

        <!-- ── Espacement dans les structures de contrôle ────────────────── -->
        <!--
            Le projet utilise le style PSR-2 : if ($x) sans espace interne.
            WordPress impose if ( $x ) avec espaces — héritage PSR-2 à conserver.
        -->
        <exclude name="WordPress.WhiteSpace.ControlStructureSpacing.NoSpaceAfterOpenParenthesis"/>
        <exclude name="WordPress.WhiteSpace.ControlStructureSpacing.NoSpaceBeforeCloseParenthesis"/>

        <!-- ── Espacement des virgules ───────────────────────────────────── -->
        <!-- Universal.WhiteSpace.CommaSpacing inclus via PHPCSExtra en WPCS 3.x -->
        <exclude name="Universal.WhiteSpace.CommaSpacing"/>

        <!-- ── Indentation ───────────────────────────────────────────────── -->
        <!--
            Le projet utilise des espaces (PSR-2). WordPress impose des tabs.
            Exclusion provisoire — migration tabs prévue en refactoring dédié.
        -->
        <exclude name="Generic.WhiteSpace.DisallowSpaceIndent"/>

        <!-- ── Commentaires ──────────────────────────────────────────────── -->
        <!--
            Commentaires inline sans point final.
            Style délibéré du projet — pas de risque sécurité.
        -->
        <exclude name="Squiz.Commenting.InlineComment.InvalidEndChar"/>
        <exclude name="Squiz.Commenting.InlineComment.WrongStyle"/>
        <exclude name="Squiz.Commenting.FunctionComment.ParamCommentFullStop"/>
        <exclude name="Squiz.Commenting.FunctionComment.MissingParamTag"/>
        <exclude name="Squiz.Commenting.FunctionComment.MissingParamComment"/>
        <exclude name="Squiz.Commenting.VariableComment.MissingVar"/>
        <exclude name="Squiz.Commenting.ClassComment.Missing"/>
        <exclude name="Squiz.Commenting.FileComment.SpacingAfterOpen"/>
        <exclude name="Generic.Commenting.DocComment.MissingShort"/>

        <!-- ── Conditions Yoda ───────────────────────────────────────────── -->
        <!--
            Le projet utilise les conditions naturelles ($x === true).
            WordPress impose les conditions Yoda (true === $x) — héritage PSR-2.
        -->
        <exclude name="WordPress.PHP.YodaConditions"/>

        <!-- ── Opérateur ternaire court ─────────────────────────────────── -->
        <!-- Universal.Operators.DisallowShortTernary inclus via PHPCSExtra en WPCS 3.x -->
        <exclude name="Universal.Operators.DisallowShortTernary"/>

        <!-- ── Espacement des opérateurs ───────────────────────────────────── -->
        <!--
            Le projet utilise un style PSR-2 avec alignement des assignations.
            L'espacement des opérateurs est géré visuellement par le dev.
        -->
        <exclude name="WordPress.WhiteSpace.OperatorSpacing.NoSpaceAfter"/>
        <exclude name="WordPress.WhiteSpace.OperatorSpacing.NoSpaceBefore"/>
        <exclude name="WordPress.WhiteSpace.OperatorSpacing.SpacingBefore"/>

        <!-- ── Espacement des tableaux ──────────────────────────────────── -->
        <!--
            Style de déclaration de tableaux : le projet utilise les tableaux
            associatifs sur une seule ligne quand la lisibilité le permet.
        -->
        <exclude name="WordPress.Arrays.ArrayDeclarationSpacing.AssociativeArrayFound"/>
        <exclude name="WordPress.Arrays.ArrayDeclarationSpacing.ArrayItemNoNewLine"/>

        <!--
            Espaces autour des clés de tableaux : $a['key'] vs $a[ 'key' ].
            Le projet utilise le style PSR-2 sans espace.
        -->
        <exclude name="WordPress.Arrays.ArrayKeySpacingRestrictions.NoSpacesAroundArrayKeys"/>

        <!-- ── Formatage ────────────────────────────────────────────────── -->
        <!--
            Alignement des assignations consécutives (colonnes).
            Déjà couvert par WordPress.Arrays.MultipleStatementAlignment.
        -->
        <exclude name="Generic.Formatting.MultipleStatementAlignment"/>

        <!-- Espacement après les casts : (int) $x vs (int)$x -->
        <exclude name="Generic.Formatting.SpaceAfterCast"/>

        <!-- Structure de cast : (int) vs (int ) -->
        <exclude name="WordPress.WhiteSpace.CastStructureSpacing"/>

        <!-- Trop d'espaces après une virgule (alignement de colonnes) -->
        <exclude name="Generic.Functions.FunctionCallArgumentSpacing.TooMuchSpaceAfterComma"/>

        <!-- ── Fins de lignes ────────────────────────────────────────────── -->
        <!--
            Fins de ligne Windows (CRLF) sur un poste Windows — environnemental.
            Git est configuré pour normaliser en LF au commit.
        -->
        <exclude name="Generic.Files.LineEndings.InvalidEOLChar"/>

        <!-- Espaces en fin de ligne (trailing whitespace) -->
        <exclude name="Squiz.WhiteSpace.SuperfluousWhitespace.EndLine"/>

        <!-- ── Structures de contrôle ────────────────────────────────────── -->
        <!--
            if sans accolades sur une seule ligne — parfois utilisé pour les gardes.
            À corriger progressivement, pas bloquant.
        -->
        <exclude name="Generic.ControlStructures.InlineControlStructure"/>

        <!-- Espacement dans les parenthèses arbitraires -->
        <exclude name="Generic.WhiteSpace.ArbitraryParenthesesSpacing"/>

        <!-- ── Fonctions / méthodes ──────────────────────────────────────── -->
        <!--
            Accolade d'ouverture sur la même ligne (K&R) — déjà le style du projet.
            Ce sniff impose une accolade sur une nouvelle ligne (Allman).
        -->
        <exclude name="Generic.Functions.OpeningFunctionBraceKernighanRitchie"/>

        <!-- Espacement après le type dans les docblocks @param -->
        <exclude name="Squiz.Commenting.FunctionComment.SpacingAfterParamType"/>

        <!-- ── PHP embarqué ─────────────────────────────────────────────── -->
        <!-- Contenu après la balise d'ouverture <?php sur la même ligne -->
        <exclude name="Squiz.PHP.EmbeddedPhp.ContentAfterOpen"/>

        <!-- ── Portée de l'indentation ──────────────────────────────────── -->
        <!-- Couvert par DisallowSpaceIndent — évite les doublons d'erreur -->
        <exclude name="Generic.WhiteSpace.ScopeIndent"/>

        <!-- ── Déclarations de classes ──────────────────────────────────── -->
        <!-- Accolade fermante de classe — style PSR-2 -->
        <exclude name="PSR2.Classes.ClassDeclaration.CloseBraceAfterBody"/>

    </rule>

    <!-- ── Capacités personnalisées de plugins tiers ────────────────────── -->
    <!--
        Le sniff ne connaît que les capacités du cœur WordPress. Celles-ci sont
        enregistrées par WooCommerce sur les rôles administrator et shop_manager
        et sont utilisées par les outils MCP produit. Les déclarer ici est le
        mécanisme prévu par le sniff : il évite d'affaiblir la vérification en
        excluant la règle, qui continue donc d'attraper les vraies fautes de
        frappe sur les capacités du cœur.
    -->
    <rule ref="WordPress.WP.Capabilities">
        <properties>
            <property name="custom_capabilities" type="array">
                <element value="edit_products"/>
                <element value="delete_products"/>
                <element value="read_product"/>
                <element value="edit_others_products"/>
                <element value="publish_products"/>
                <element value="manage_woocommerce"/>
            </property>
        </properties>
    </rule>

    <!-- ── Désactivation globale (ceinture et bretelles) ────────────────── -->
    <!-- Garantit la suppression quelle que soit la version WPCS/PHPCSExtra  -->

    <rule ref="Generic.Arrays.DisallowShortArraySyntax">
        <severity>0</severity>
    </rule>
    <rule ref="Universal.Arrays.DisallowShortArraySyntax">
        <severity>0</severity>
    </rule>
    <rule ref="Generic.WhiteSpace.DisallowSpaceIndent">
        <severity>0</severity>
    </rule>
    <rule ref="PEAR.Functions.FunctionCallSignature">
        <severity>0</severity>
    </rule>
    <rule ref="NormalizedArrays.Arrays.ArrayBraceSpacing">
        <severity>0</severity>
    </rule>
    <rule ref="NormalizedArrays.Arrays.CommaAfterLast">
        <severity>0</severity>
    </rule>
    <rule ref="Universal.WhiteSpace.CommaSpacing">
        <severity>0</severity>
    </rule>
    <rule ref="Universal.Operators.DisallowShortTernary">
        <severity>0</severity>
    </rule>
    <rule ref="WordPress.PHP.YodaConditions">
        <severity>0</severity>
    </rule>

    <!-- ── Comportements intentionnels (warnings supprimés globalement) ─── -->

    <!--
        error_log() ne doit pas être ignoré globalement.
        Exception temporaire limitée au fichier qui journalise la composition dynamique.
        Objectif à terme : remplacer par logging conditionnel centralisé.
    -->
    <rule ref="WordPress.PHP.DevelopmentFunctions">
        <exclude-pattern>./classes/class-block-editor-autoload.php</exclude-pattern>
    </rule>

    <!--
        file_get_contents() sur des fichiers LOCAUX : wp_remote_get() est réservé
        aux requêtes HTTP distantes. Ici, file_get_contents() lit des fichiers du
        thème (JSON, CSS) depuis le filesystem — c'est l'usage correct.
    -->
    <rule ref="WordPress.WP.AlternativeFunctions.file_get_contents_file_get_contents">
        <severity>0</severity>
    </rule>

    <!--
        @filemtime() ne doit pas être ignoré globalement.
        Exception temporaire limitée au fichier de composition theme.json.
    -->
    <rule ref="WordPress.PHP.NoSilencedErrors">
        <exclude-pattern>./classes/class-block-editor-autoload.php</exclude-pattern>
    </rule>

    <!--
        Les paramètres inutilisés doivent être gérés au cas par cas
        via phpcs:ignore local quand imposés par une signature WordPress.
    -->

    <!--
        Requêtes SQL directes : exception limitée à la couche query dédiée.
        Toute nouvelle requête directe hors ce fichier doit être revue.
    -->
    <rule ref="WordPress.DB.DirectDatabaseQuery">
        <exclude-pattern>./classes/class-portfolio-query.php</exclude-pattern>
    </rule>

    <!--
        SlowDBQuery : tax_query intentionnel — aucune alternative sans requête SQL.
    -->
    <rule ref="WordPress.DB.SlowDBQuery">
        <severity>0</severity>
    </rule>

    <!--
        rename() dans class-github-updater.php : renommage de dossier lors de
        la mise à jour depuis GitHub. WP_Filesystem->move() n'est pas disponible
        dans ce contexte sans instance $wp_filesystem initialisée.
    -->
    <rule ref="WordPress.WP.AlternativeFunctions.rename_rename">
        <severity>0</severity>
    </rule>

    <!--
        $false comme nom de paramètre dans class-github-updater.php :
        convention héritée de la signature du filtre 'pre_set_site_transient_update_themes'.
        Renommer casserait la compatibilité avec le hook WordPress.
    -->
    <rule ref="Universal.NamingConventions.NoReservedKeywordParameterNames">
        <severity>0</severity>
    </rule>

    <!-- ── Configuration WordPress ──────────────────────────────────────── -->
    <config name="minimum_wp_version" value="6.8"/>

    <!-- Text domain du theme -->
    <rule ref="WordPress.WP.I18n">
        <properties>
            <property name="text_domain" type="array">
                <element value="g2rd"/>
            </property>
        </properties>
    </rule>

    <!-- Prefixes des fonctions et hooks globaux -->
    <rule ref="WordPress.NamingConventions.PrefixAllGlobals">
        <properties>
            <property name="prefixes" type="array">
                <element value="g2rd"/>
                <element value="G2RD"/>
            </property>
        </properties>
    </rule>

    <!-- PHPCompatibility pour PHP 8.0+ -->
    <config name="testVersion" value="8.0-"/>
    <rule ref="PHPCompatibilityWP">
        <include-pattern>*\.php$</include-pattern>
    </rule>

</ruleset>
