<?xml version="1.0"?>
<ruleset name="G2RD Theme">
    <description>Regles PHPCS pour le theme G2RD (WordPress + Security)</description>

    <!-- Chemins a scanner -->
    <file>./classes</file>
    <file>./functions.php</file>
    <file>./includes</file>
    <file>./index.php</file>

    <!-- Chemins a ignorer -->
    <exclude-pattern>./vendor/*</exclude-pattern>
    <exclude-pattern>./node_modules/*</exclude-pattern>
    <exclude-pattern>./blocks/*/build/*</exclude-pattern>
    <exclude-pattern>./blocks/*/src/*</exclude-pattern>
    <exclude-pattern>./blocks/*/*.php</exclude-pattern>
    <exclude-pattern>./assets/js/vendor/*</exclude-pattern>

    <!-- Extensions PHP -->
    <arg name="extensions" value="php"/>
    <arg name="colors"/>
    <arg value="ps"/>

    <!-- WordPress Coding Standards -->
    <rule ref="WordPress">
        <!-- Noms de fichiers : les classes utilisent PascalCase/underscores -->
        <exclude name="WordPress.Files.FileName.NotHyphenatedLowercase"/>
        <exclude name="WordPress.Files.FileName.InvalidClassFileName"/>

        <!--
            Noms de méthodes : le projet utilise camelCase (héritage PSR-2).
            À migrer progressivement vers snake_case via refactoring dédié.
        -->
        <exclude name="WordPress.NamingConventions.ValidFunctionName.MethodNameInvalid"/>

        <!--
            Alignement des double-flèches dans les tableaux multi-lignes.
            Désactivé car les tableaux complexes (Abilities API) utilisent
            une indentation fonctionnelle plutôt que cosmétique.
        -->
        <exclude name="WordPress.Arrays.MultipleStatementAlignment"/>

        <!--
            Syntaxe courte des tableaux [] : autorisée car le projet cible PHP 8.0+
            et la syntaxe courte est plus lisible et moderne.
        -->
        <exclude name="Generic.Arrays.DisallowShortArraySyntax"/>

        <!--
            Espaces à l'intérieur des parenthèses d'appels de fonctions.
            Le projet utilise le style PSR-2 sans espace interne : func('arg').
        -->
        <exclude name="WordPress.WhiteSpace.FunctionCallSignature.SpaceAfterOpenBracket"/>
        <exclude name="WordPress.WhiteSpace.FunctionCallSignature.SpaceBeforeCloseBracket"/>
        <exclude name="WordPress.WhiteSpace.FunctionCallSignature.NoSpaceBeforeOpenBracket"/>
    </rule>

    <!--
        Ceinture et bretelles : ces règles sont aussi exclues dans le bloc WordPress
        ci-dessus, mais on les désactive aussi ici au niveau global pour garantir
        la suppression quelle que soit la version de WPCS ou le comportement d'héritage PHPCS.
    -->

    <!-- PHP 8.0+ : syntaxe courte [] autorisée -->
    <rule ref="Generic.Arrays.DisallowShortArraySyntax">
        <severity>0</severity>
    </rule>

    <!-- PSR-2 : pas d'espaces à l'intérieur des parenthèses d'appels de fonctions -->
    <rule ref="WordPress.WhiteSpace.FunctionCallSignature">
        <severity>0</severity>
    </rule>

    <!-- Configuration WordPress specifique -->
    <config name="minimum_wp_version" value="6.8"/>

    <!-- Text domain du theme -->
    <rule ref="WordPress.WP.I18n">
        <properties>
            <property name="text_domain" type="array">
                <element value="g2rd"/>
            </property>
        </properties>
    </rule>

    <!-- Prefixes des fonctions et hooks -->
    <rule ref="WordPress.NamingConventions.PrefixAllGlobals">
        <properties>
            <property name="prefixes" type="array">
                <element value="g2rd"/>
                <element value="G2RD"/>
            </property>
        </properties>
    </rule>

    <!-- PHPCompatibility pour PHP 8.0+ -->
    <config name="testVersion" value="8.0-"/>
    <rule ref="PHPCompatibilityWP">
        <include-pattern>*\.php$</include-pattern>
    </rule>
</ruleset>
