{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "useRootPaddingAwareAlignments": true,
    "layout": {
      "contentSize": "960px",
      "wideSize": "1440px",
      "allowCustomContentAndWideSize": true,
      "allowEditing": true
    },
    "appearanceTools": true,
    "color": {
      "defaultDuotone": false,
      "customDuotone": false,
      "defaultGradients": false,
      "customGradient": false,
      "defaultPalette": false,
      "custom": false,
      "palette": [
        {
          "name": "Navy",
          "slug": "primary",
          "color": "#0f172a"
        },
        {
          "name": "Lime",
          "slug": "secondary",
          "color": "#a3e635"
        },
        {
          "name": "Blanc",
          "slug": "white",
          "color": "#ffffff"
        },
        {
          "name": "Navy profond",
          "slug": "blue-dark",
          "color": "#020617"
        },
        {
          "name": "Navy doux",
          "slug": "blue-soft",
          "color": "#1e293b"
        },
        {
          "name": "Gris clair",
          "slug": "cream",
          "color": "#f8fafc"
        },
        {
          "name": "Texte atténué",
          "slug": "muted",
          "color": "#64748b"
        },
        {
          "name": "Magenta",
          "slug": "accent",
          "color": "#ec4899"
        },
        {
          "name": "Violet",
          "slug": "accent-2",
          "color": "#a855f7"
        },
        {
          "name": "Bordure",
          "slug": "border",
          "color": "#e2e8f0"
        },
        {
          "name": "Surface",
          "slug": "surface",
          "color": "#f1f5f9"
        },
        {
          "name": "Succès",
          "slug": "success",
          "color": "#22c55e"
        },
        {
          "name": "Avertissement",
          "slug": "warning",
          "color": "#f59e0b"
        },
        {
          "name": "Danger",
          "slug": "danger",
          "color": "#ef4444"
        }
      ],
      "gradients": [
        {
          "name": "Navy dégradé",
          "slug": "blue",
          "gradient": "linear-gradient(90deg, #0f172a 0%, #f8fafc 100%)"
        },
        {
          "name": "Lime dégradé",
          "slug": "beige",
          "gradient": "linear-gradient(90deg, #a3e635 0%, #f8fafc 100%)"
        },
        {
          "name": "Navy lime",
          "slug": "bleubeige",
          "gradient": "linear-gradient(135deg, #0f172a 0%, #a3e635 100%)"
        },
        {
          "name": "Action (magenta-violet)",
          "slug": "secondary",
          "gradient": "linear-gradient(135deg, #ec4899 0%, #a855f7 100%)"
        },
        {
          "name": "Section sombre",
          "slug": "magic-dark",
          "gradient": "linear-gradient(135deg, #020617 0%, #0f172a 58%, #020617 100%)"
        },
        {
          "name": "Section claire",
          "slug": "magic-light",
          "gradient": "linear-gradient(180deg, #ffffff 0%, #f8fafc 100%)"
        }
      ],
      "duotone": [
        {
          "name": "Navy lime",
          "slug": "blue",
          "colors": ["#0f172a", "#a3e635"]
        },
        {
          "name": "Magenta violet",
          "slug": "pink",
          "colors": ["#ec4899", "#a855f7"]
        },
        {
          "name": "Navy lime clair",
          "slug": "green",
          "colors": ["#0f172a", "#a3e635"]
        }
      ],
      "link": true,
      "text": true,
      "background": true,
      "caption": true,
      "button": true,
      "heading": true
    },
    "spacing": {
      "blockGap": true,
      "customSpacingSize": false,
      "defaultSpacingSizes": false,
      "margin": false,
      "padding": true,
      "units": ["%", "em", "rem", "vh", "vw"],
      "spacingSizes": [
        {
          "name": "Très petit",
          "size": "1rem",
          "slug": "xs"
        },
        {
          "name": "Petit",
          "size": "1.6rem",
          "slug": "s"
        },
        {
          "name": "Moyen",
          "size": "3.2rem",
          "slug": "m"
        },
        {
          "name": "Grand",
          "size": "4.8rem",
          "slug": "l"
        },
        {
          "name": "Très grand",
          "size": "6.4rem",
          "slug": "xl"
        }
      ],
      "spacingScale": {}
    },
    "typography": {
      "customFontSize": true,
      "defaultFontSizes": true,
      "dropCap": true,
      "fontStyle": true,
      "fontWeight": true,
      "letterSpacing": true,
      "lineHeight": true,
      "textAlign": true,
      "textColumns": true,
      "textDecoration": true,
      "textTransform": true,
      "writingMode": true,
      "fontFamilies": [
        {
          "fontFamily": "Rubik",
          "name": "Rubik",
          "slug": "rubik",
          "fontFace": [
            {
              "fontFamily": "Rubik",
              "fontDisplay": "swap",
              "fontStretch": "normal",
              "fontStyle": "normal",
              "fontWeight": "400",
              "src": ["file:./assets/fonts/Rubik-Regular.woff2"]
            }
          ]
        },
        {
          "fontFamily": "'Quantum', sans-serif",
          "name": "Quantum",
          "slug": "Quantum",
          "fontFace": [
            {
              "fontFamily": "Quantum",
              "fontDisplay": "swap",
              "fontStretch": "normal",
              "fontStyle": "normal",
              "fontWeight": "400",
              "src": ["file:./assets/fonts/Quantum.woff2"]
            }
          ]
        },
        {
          "fontFamily": "DM Serif Display",
          "name": "DM Serif Display",
          "slug": "dm-serif-display",
          "fontFace": [
            {
              "fontFamily": "DM Serif Display",
              "fontDisplay": "swap",
              "fontStretch": "normal",
              "fontStyle": "normal",
              "fontWeight": "400",
              "src": ["file:./assets/fonts/DMSerifDisplay-Regular.woff2"]
            }
          ]
        },
        {
          "fontFamily": "'Audiowide', sans-serif",
          "name": "Audiowide",
          "slug": "audiowide",
          "fontFace": [
            {
              "fontFamily": "Audiowide",
              "fontDisplay": "swap",
              "fontStretch": "normal",
              "fontStyle": "normal",
              "fontWeight": "400",
              "src": ["file:./assets/fonts/audiowide.woff2"]
            }
          ]
        },
        {
          "fontFamily": "Inter, sans-serif",
          "name": "Inter",
          "slug": "inter",
          "fontFace": [
            {
              "fontFamily": "Inter",
              "fontDisplay": "swap",
              "fontStretch": "normal",
              "fontStyle": "normal",
              "fontWeight": "400",
              "src": ["file:./assets/fonts/Inter_28pt-Regular.woff2"]
            }
          ]
        },
        {
          "fontFamily": "Plus Jakarta Sans, sans-serif",
          "name": "Plus Jakarta Sans",
          "slug": "plus-jakarta-sans",
          "fontFace": [
            {
              "fontFamily": "Plus Jakarta Sans",
              "fontDisplay": "swap",
              "fontStretch": "normal",
              "fontStyle": "normal",
              "fontWeight": "400",
              "src": ["file:./assets/fonts/PlusJakartaSans-Regular.woff2"]
            }
          ]
        },
        {
          "fontFamily": "Acme, sans-serif",
          "name": "Acme",
          "slug": "acme",
          "fontFace": [
            {
              "fontFamily": "Acme",
              "fontDisplay": "swap",
              "fontStretch": "normal",
              "fontStyle": "normal",
              "fontWeight": "400",
              "src": ["file:./assets/fonts/Acme-Regular.woff2"]
            }
          ]
        },
        {
          "fontFamily": "Borel, cursive",
          "name": "Borel",
          "slug": "borel",
          "fontFace": [
            {
              "fontFamily": "Borel",
              "fontDisplay": "swap",
              "fontStretch": "normal",
              "fontStyle": "normal",
              "fontWeight": "400",
              "src": ["file:./assets/fonts/Borel-Regular.woff2"]
            }
          ]
        }
      ],
      "fontSizes": [
        {
          "name": "Petit",
          "size": "0.88rem",
          "slug": "s",
          "fluid": {
            "min": "0.55rem",
            "max": "0.88rem"
          }
        },
        {
          "name": "Moyen",
          "size": "1.125rem",
          "slug": "m",
          "fluid": {
            "min": "1rem",
            "max": "1.125rem"
          }
        },
        {
          "name": "Grand",
          "size": "1.4rem",
          "slug": "l",
          "fluid": {
            "min": "1.125rem",
            "max": "1.4rem"
          }
        },
        {
          "name": "Très Grand",
          "size": "3rem",
          "slug": "xl",
          "fluid": {
            "min": "1.5rem",
            "max": "3rem"
          }
        },
        {
          "name": "Énorme",
          "size": "4rem",
          "slug": "xxl",
          "fluid": {
            "min": "2rem",
            "max": "4rem"
          }
        }
      ]
    },
    "custom": {
      "fontWeight": {
        "regular": 400,
        "semibold": 600,
        "bold": 700
      },
      "lineHeight": {
        "narrow": 1.2,
        "regular": 1.5,
        "large": 1.8
      },
      "radius": {
        "xs": "4px",
        "s": "8px",
        "m": "12px",
        "l": "16px",
        "xl": "24px",
        "full": "999px"
      },
      "button": {
        "radius": "10px",
        "radius-pill": "999px",
        "radius-square": "4px",
        "padding-h": "1.5rem",
        "padding-v": "0.75rem",
        "font-weight": 600,
        "transition": "0.2s cubic-bezier(0.16, 1, 0.3, 1)"
      },
      "color": {
        "primaryhover": "#1e293b",
        "secondaryhover": "#84cc16",
        "whitehover": "#f1f5f9",
        "accenthover": "#db2777",
        "neutral-50": "#f8fafc",
        "neutral-100": "#f1f5f9",
        "neutral-200": "#e2e8f0",
        "neutral-500": "#64748b",
        "neutral-700": "#334155",
        "neutral-900": "#0f172a"
      }
    },
    "blocks": {
      "core/group": {
        "layout": {
          "allowEditing": true,
          "allowCustomContentAndWideSize": true
        },
        "spacing": {
          "padding": true,
          "margin": true
        }
      },
      "core/row": {
        "layout": {
          "allowEditing": true,
          "allowCustomContentAndWideSize": true
        }
      },
      "core/image": {
        "lightbox": {
          "enabled": true,
          "allowEditing": true
        }
      },
      "g2rd/countdown": {
        "color": {
          "background": true,
          "text": true
        },
        "spacing": {
          "margin": true,
          "padding": true
        },
        "typography": {
          "fontSize": true,
          "fontFamily": true,
          "fontWeight": true,
          "lineHeight": true
        }
      }
    },
    "border": {
      "color": true,
      "radius": true,
      "style": true,
      "width": true
    },
    "background": {
      "backgroundImage": true,
      "backgroundSize": true
    },
    "dimensions": {
      "defaultAspectRatios": true,
      "aspectRatio": true,
      "minHeight": true
    },
    "position": {
      "sticky": true
    },
    "shadow": {
      "defaultPresets": false,
      "presets": [
        {
          "name": "Très légère",
          "slug": "xs",
          "shadow": "0 1px 2px rgba(15, 23, 42, 0.06), 0 1px 3px rgba(15, 23, 42, 0.10)"
        },
        {
          "name": "Douce",
          "slug": "light",
          "shadow": "0 1px 3px rgba(15, 23, 42, 0.10), 0 1px 2px rgba(15, 23, 42, 0.06)"
        },
        {
          "name": "Moyenne",
          "slug": "md",
          "shadow": "0 4px 6px -1px rgba(15, 23, 42, 0.10), 0 2px 4px -2px rgba(15, 23, 42, 0.06)"
        },
        {
          "name": "Fine",
          "slug": "neat",
          "shadow": "0 1px 0 rgba(15, 23, 42, 0.04), 0 2px 8px rgba(15, 23, 42, 0.08)"
        },
        {
          "name": "Imposante",
          "slug": "huge",
          "shadow": "0 10px 15px -3px rgba(15, 23, 42, 0.10), 0 4px 6px -4px rgba(15, 23, 42, 0.08)"
        },
        {
          "name": "Élevée",
          "slug": "xl",
          "shadow": "0 20px 25px -5px rgba(15, 23, 42, 0.12), 0 8px 10px -6px rgba(15, 23, 42, 0.08)"
        },
        {
          "name": "Lueur navy",
          "slug": "primary-glow",
          "shadow": "0 4px 24px rgba(15, 23, 42, 0.28), 0 2px 8px rgba(15, 23, 42, 0.14)"
        },
        {
          "name": "Lueur lime",
          "slug": "secondary-glow",
          "shadow": "0 10px 15px -3px rgba(163, 230, 53, 0.25), 0 4px 6px -4px rgba(163, 230, 53, 0.20)"
        },
        {
          "name": "Lueur magenta-violet",
          "slug": "accent-glow",
          "shadow": "0 10px 15px -3px rgba(236, 72, 153, 0.25), 0 4px 6px -4px rgba(168, 85, 247, 0.22)"
        },
        {
          "name": "Magic — Carte",
          "slug": "magic",
          "shadow": "0 24px 60px -12px rgba(15, 23, 42, 0.25)"
        },
        {
          "name": "Magic — Carte XL",
          "slug": "magic-xl",
          "shadow": "0 32px 80px -16px rgba(15, 23, 42, 0.22)"
        }
      ]
    }
  }
}
