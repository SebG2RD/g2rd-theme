<?xml version="1.0"?>
<ruleset name="G2RD Security Audit">
    <description>Audit de sécurité OWASP pour le thème G2RD.
    Les sniffs ci-dessous sont exclus car ils produisent des faux positifs documentés.
    </description>

    <rule ref="Security">
        <!-- Faux positifs : chemins filesystem tous issus de get_template_directory() ou __DIR__ -->
        <exclude name="Security.BadFunctions.FilesystemFunctions"/>

        <!-- Faux positifs : callbacks array_map() avec trim, esc_url_raw ou méthodes internes -->
        <exclude name="Security.BadFunctions.CallbackFunctions"/>
    </rule>
</ruleset>
