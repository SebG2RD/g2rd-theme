{
  "name": "g2rd-theme",
  "version": "1.24.16",
  "private": true,
  "workspaces": [
    "blocks/g2rd-card",
    "blocks/g2rd-pricing-table",
    "blocks/g2rd-code",
    "blocks/g2rd-filterable-grid",
    "blocks/g2rd-advanced-heading",
    "blocks/g2rd-carousel",
    "blocks/g2rd-charts",
    "blocks/g2rd-container",
    "blocks/g2rd-countdown",
    "blocks/g2rd-counter",
    "blocks/g2rd-dynamic-content",
    "blocks/g2rd-faq",
    "blocks/g2rd-info",
    "blocks/g2rd-typed",
    "blocks/g2rd-block-api",
    "blocks/g2rd-hero",
    "blocks/g2rd-testimonial",
    "blocks/g2rd-cta-band",
    "blocks/g2rd-effect-kits",
    "blocks/g2rd-geo-analyzer",
    "blocks/g2rd-geo-summary",
    "blocks/g2rd-geo-faq",
    "blocks/g2rd-options-page",
    "blocks/g2rd-pin-scroll",
    "blocks/g2rd-mcp-assistant",
    "blocks/g2rd-ai-editor"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "start": "npm run start --workspaces --if-present",
    "audit:blocks": "node tools/audit-blocks.mjs",
    "audit:blocks:strict": "node tools/audit-blocks.mjs --strict",
    "test:blocks": "wp-scripts test-unit-js --runInBand --ci --passWithNoTests",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "build:advanced-heading": "npm run build --workspace=blocks/g2rd-advanced-heading",
    "build:card": "npm run build --workspace=blocks/g2rd-card",
    "build:charts": "npm run build --workspace=blocks/g2rd-charts",
    "build:filterable-grid": "npm run build --workspace=blocks/g2rd-filterable-grid",
    "build:code": "npm run build --workspace=blocks/g2rd-code",
    "build:carousel": "npm run build --workspace=blocks/g2rd-carousel",
    "build:container": "npm run build --workspace=blocks/g2rd-container",
    "build:countdown": "npm run build --workspace=blocks/g2rd-countdown",
    "build:counter": "npm run build --workspace=blocks/g2rd-counter",
    "build:dynamic-content": "npm run build --workspace=blocks/g2rd-dynamic-content",
    "build:faq": "npm run build --workspace=blocks/g2rd-faq",
    "build:info": "npm run build --workspace=blocks/g2rd-info",
    "build:typed": "npm run build --workspace=blocks/g2rd-typed",
    "build:pricing-table": "npm run build --workspace=blocks/g2rd-pricing-table",
    "build:block-api": "npm run build --workspace=blocks/g2rd-block-api",
    "build:hero": "npm run build --workspace=blocks/g2rd-hero",
    "build:testimonial": "npm run build --workspace=blocks/g2rd-testimonial",
    "build:cta-band": "npm run build --workspace=blocks/g2rd-cta-band",
    "build:effect-kits": "npm run build --workspace=blocks/g2rd-effect-kits",
    "build:geo-analyzer": "npm run build --workspace=blocks/g2rd-geo-analyzer",
    "build:geo-summary": "npm run build --workspace=blocks/g2rd-geo-summary",
    "build:geo-faq": "npm run build --workspace=blocks/g2rd-geo-faq",
    "build:geo": "npm run build:geo-analyzer && npm run build:geo-summary && npm run build:geo-faq",
    "build:options": "npm run build --workspace=blocks/g2rd-options-page",
    "build:pin-scroll": "npm run build --workspace=blocks/g2rd-pin-scroll",
    "build:mcp-assistant": "npm run build --workspace=blocks/g2rd-mcp-assistant",
    "build:ai-editor": "npm run build --workspace=blocks/g2rd-ai-editor"
  },
  "bin": {
    "g2rd-mcp-bridge": "tools/g2rd-mcp-bridge.js"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@wordpress/scripts": "^33.0.0",
    "dotenv": "^17.4.2"
  },
  "overrides": {
    "postcss": "^8.5.10",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@typescript-eslint/type-utils": "^8.0.0",
    "@typescript-eslint/typescript-estree": "^8.0.0",
    "@typescript-eslint/utils": "^8.0.0",
    "basic-ftp": ">=5.3.0",
    "follow-redirects": ">=1.16.0",
    "minimatch": ">=3.1.4",
    "copy-webpack-plugin": "^14.0.0",
    "markdownlint-cli": "^0.48.0",
    "markdownlint": "^0.38.0",
    "markdown-it": "^14.2.0",
    "smol-toml": "^1.6.1",
    "serialize-javascript": "^7.0.5",
    "webpack-dev-server": "^5.2.5",
    "http-proxy-middleware": "^2.0.10",
    "js-yaml": "^4.2.0",
    "@babel/core": "^7.29.6",
    "@opentelemetry/core": "^2.8.0",
    "uuid": ">=11.1.1",
    "brace-expansion": ">=5.0.6",
    "ws": ">=8.20.1",
    "websocket-driver": ">=0.7.5",
    "webpack": "^5.108.1",
    "@wordpress/scripts": {
      "copy-webpack-plugin": "^14.0.0",
      "markdownlint-cli": "^0.48.0",
      "markdownlint": "^0.38.0",
      "markdown-it": "^14.1.1",
      "smol-toml": "^1.6.1",
      "serialize-javascript": "^7.0.5",
      "webpack-dev-server": "^5.2.5",
      "uuid": ">=11.1.1",
      "brace-expansion": ">=5.0.6",
      "ws": ">=8.20.1",
      "qs": ">=6.15.2"
    }
  }
}
