{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "title": "WP Manager",
  "settings": {
    "color": {
      "palette": [
        {
          "name": "Primary",
          "slug": "primary",
          "color": "#0A0E27"
        },
        {
          "name": "Accent",
          "slug": "accent",
          "color": "#B9FF56"
        },
        {
          "name": "UI Primary",
          "slug": "secondary",
          "color": "#30445F"
        },
        {
          "name": "Surface",
          "slug": "white",
          "color": "#FFFFFF"
        },
        {
          "name": "Neutral 100",
          "slug": "neutral-100",
          "color": "#E0E3E7"
        },
        {
          "name": "Neutral 500",
          "slug": "neutral-500",
          "color": "#647182"
        },
        {
          "name": "Neutral 900",
          "slug": "neutral-900",
          "color": "#121417"
        }
      ],
      "gradients": [
        {
          "name": "Brand Gradient",
          "slug": "brand-gradient",
          "gradient": "linear-gradient(135deg, #E91E8C 0%, #7B1FA2 100%)"
        }
      ]
    },
    "typography": {
      "fontFamilies": [
        {
          "fontFamily": "'Plus Jakarta Sans', system-ui, sans-serif",
          "name": "Plus Jakarta Sans",
          "slug": "primary",
          "fontFace": [
            {
              "fontDisplay": "swap",
              "fontFamily": "Plus Jakarta Sans",
              "fontStyle": "normal",
              "fontWeight": "400",
              "src": ["https://fonts.gstatic.com/s/plusjakartasans/v8/LDIbaomQNQcsA88c7O9yZ4KMCoOg4IA6-91aHEjcWuA_qU79Tph_MX73nMDykLCu0rA.woff2"]
            },
            {
              "fontDisplay": "swap",
              "fontFamily": "Plus Jakarta Sans",
              "fontStyle": "normal",
              "fontWeight": "700",
              "src": ["https://fonts.gstatic.com/s/plusjakartasans/v8/LDIbaomQNQcsA88c7O9yZ4KMCoOg4IA6-91aHEjcWuA_qU79Tph_MX73nBzwkLCu0rA.woff2"]
            },
            {
              "fontDisplay": "swap",
              "fontFamily": "Plus Jakarta Sans",
              "fontStyle": "normal",
              "fontWeight": "800",
              "src": ["https://fonts.gstatic.com/s/plusjakartasans/v8/LDIbaomQNQcsA88c7O9yZ4KMCoOg4IA6-91aHEjcWuA_qU79Tph_MX73nAzwkLCu0rA.woff2"]
            }
          ]
        }
      ],
      "fontSizes": [
        {
          "name": "XS — Caption",
          "slug": "xs",
          "size": "0.75rem"
        },
        {
          "name": "SM — Label",
          "slug": "sm",
          "size": "0.875rem"
        },
        {
          "name": "Base",
          "slug": "base",
          "size": "1rem"
        },
        {
          "name": "LG — Sous-titre",
          "slug": "lg",
          "size": "1.125rem"
        },
        {
          "name": "3XL — H2",
          "slug": "3xl",
          "size": "1.875rem"
        },
        {
          "name": "5XL — H1",
          "slug": "5xl",
          "size": "3rem"
        }
      ]
    }
  },
  "styles": {
    "color": {
      "background": "var(--wp--preset--color--white)",
      "text": "var(--wp--preset--color--primary)"
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--primary)",
      "fontSize": "var(--wp--preset--font-size--base)",
      "lineHeight": "1.6"
    },
    "elements": {
      "h1": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--primary)",
          "fontSize": "var(--wp--preset--font-size--5xl)",
          "fontWeight": "800",
          "letterSpacing": "-0.05em",
          "lineHeight": "1.1"
        },
        "color": {
          "text": "var(--wp--preset--color--primary)"
        }
      },
      "h2": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--primary)",
          "fontSize": "var(--wp--preset--font-size--3xl)",
          "fontWeight": "700",
          "lineHeight": "1.2"
        },
        "color": {
          "text": "var(--wp--preset--color--primary)"
        }
      },
      "h3": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--primary)",
          "fontWeight": "600"
        },
        "color": {
          "text": "var(--wp--preset--color--primary)"
        }
      },
      "link": {
        "color": {
          "text": "var(--wp--preset--color--secondary)"
        },
        ":hover": {
          "color": {
            "text": "var(--wp--preset--color--accent)"
          }
        }
      },
      "button": {
        "color": {
          "background": "var(--wp--preset--color--accent)",
          "text": "var(--wp--preset--color--primary)"
        },
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--primary)",
          "fontWeight": "700"
        },
        ":hover": {
          "color": {
            "background": "var(--wp--preset--color--primary)",
            "text": "var(--wp--preset--color--accent)"
          }
        }
      }
    }
  }
}
