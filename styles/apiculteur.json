{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "title": "Apiculteur",
  "settings": {
    "color": {
      "palette": [
        {
          "name": "Espresso",
          "slug": "primary",
          "color": "#1C1208"
        },
        {
          "name": "Bronze miel",
          "slug": "secondary",
          "color": "#9A6413"
        },
        {
          "name": "Or du rucher",
          "slug": "accent",
          "color": "#C9911F"
        },
        {
          "name": "Mousse de forêt",
          "slug": "contrast",
          "color": "#3A5128"
        },
        {
          "name": "Neutre clair",
          "slug": "neutral-300",
          "color": "#D6C9AC"
        },
        {
          "name": "Neutre moyen",
          "slug": "neutral-600",
          "color": "#7A6A52"
        },
        {
          "name": "Lin chaud",
          "slug": "white",
          "color": "#FDFAF3"
        },
        {
          "name": "Bordure",
          "slug": "border",
          "color": "#E8DEC9"
        },
        {
          "name": "Surface",
          "slug": "surface",
          "color": "#F5EEDF"
        },
        {
          "name": "Texte atténué",
          "slug": "muted",
          "color": "#7A6A52"
        },
        {
          "name": "Crème",
          "slug": "cream",
          "color": "#F7F1E6"
        }
      ],
      "gradients": [
        {
          "name": "Dégradé miel",
          "slug": "honey-gradient",
          "gradient": "linear-gradient(135deg, #C9911F 0%, #E8B84B 50%, #C9911F 100%)"
        },
        {
          "name": "Dégradé sombre",
          "slug": "dark-gradient",
          "gradient": "linear-gradient(160deg, #1C1208 0%, #3A2510 100%)"
        },
        {
          "name": "Dégradé action",
          "slug": "secondary",
          "gradient": "linear-gradient(135deg, #9A6413 0%, #7A4E0F 100%)"
        }
      ]
    },
    "shadow": {
      "presets": [
        {
          "name": "Légère",
          "slug": "light",
          "shadow": "0 4px 16px rgba(28,18,8,0.08)"
        },
        {
          "name": "Forte",
          "slug": "huge",
          "shadow": "0 20px 50px rgba(28,18,8,0.18)"
        },
        {
          "name": "Halo accent",
          "slug": "accent-glow",
          "shadow": "0 10px 30px rgba(201,145,31,0.35)"
        }
      ]
    },
    "typography": {
      "fontFamilies": [
        {
          "fontFamily": "'Satisfy', 'Segoe Script', cursive",
          "name": "Satisfy",
          "slug": "primary",
          "fontFace": [
            {
              "fontDisplay": "block",
              "fontFamily": "Satisfy",
              "fontStretch": "normal",
              "fontStyle": "normal",
              "fontWeight": "400",
              "src": ["https://fonts.gstatic.com/s/satisfy/v21/rP2Hp2yn6lkG50LoCZOIHTWEBlw.woff2"]
            }
          ]
        },
        {
          "fontFamily": "Poppins, system-ui, sans-serif",
          "name": "Poppins",
          "slug": "secondary",
          "fontFace": [
            {
              "fontDisplay": "swap",
              "fontFamily": "Poppins",
              "fontStretch": "normal",
              "fontStyle": "normal",
              "fontWeight": "400",
              "src": ["https://fonts.gstatic.com/s/poppins/v21/pxiEyp8kv8JHgFVrJJfecg.woff2"]
            },
            {
              "fontDisplay": "swap",
              "fontFamily": "Poppins",
              "fontStretch": "normal",
              "fontStyle": "normal",
              "fontWeight": "600",
              "src": ["https://fonts.gstatic.com/s/poppins/v21/pxiByp8kv8JHgFVrLEj6Z1xlFQ.woff2"]
            }
          ]
        },
        {
          "fontFamily": "Poppins, system-ui, sans-serif",
          "name": "Inter (Poppins)",
          "slug": "inter"
        },
        {
          "fontFamily": "Poppins, system-ui, sans-serif",
          "name": "Plus Jakarta (Poppins)",
          "slug": "plus-jakarta-sans"
        }
      ],
      "fontSizes": [
        {
          "name": "XS — Légende",
          "slug": "xs",
          "size": "0.75rem"
        },
        {
          "name": "SM — Label",
          "slug": "sm",
          "size": "0.875rem"
        },
        {
          "name": "Base — Corps",
          "slug": "base",
          "size": "1rem"
        },
        {
          "name": "LG — Accroche",
          "slug": "lg",
          "size": "1.2rem"
        },
        {
          "name": "2XL — H3",
          "slug": "2xl",
          "size": "1.65rem",
          "fluid": {
            "min": "1.3rem",
            "max": "2.05rem"
          }
        },
        {
          "name": "4XL — H2",
          "slug": "4xl",
          "size": "2.5rem",
          "fluid": {
            "min": "1.85rem",
            "max": "3.15rem"
          }
        },
        {
          "name": "6XL — H1",
          "slug": "6xl",
          "size": "3.5rem",
          "fluid": {
            "min": "2.4rem",
            "max": "4.35rem"
          }
        }
      ]
    }
  },
  "styles": {
    "color": {
      "background": "var(--wp--preset--color--white)",
      "text": "var(--wp--preset--color--primary)"
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--secondary)",
      "fontSize": "var(--wp--preset--font-size--base)",
      "lineHeight": "1.75"
    },
    "elements": {
      "h1": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--primary)",
          "fontSize": "var(--wp--preset--font-size--6xl)",
          "fontWeight": "400",
          "lineHeight": "1.12",
          "letterSpacing": "0.01em"
        },
        "color": {
          "text": "var(--wp--preset--color--primary)"
        }
      },
      "h2": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--primary)",
          "fontSize": "var(--wp--preset--font-size--4xl)",
          "fontWeight": "400",
          "lineHeight": "1.18",
          "letterSpacing": "0.01em"
        },
        "color": {
          "text": "var(--wp--preset--color--primary)"
        }
      },
      "h3": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--primary)",
          "fontSize": "var(--wp--preset--font-size--2xl)",
          "fontWeight": "400",
          "lineHeight": "1.28"
        },
        "color": {
          "text": "var(--wp--preset--color--secondary)"
        }
      },
      "h4": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--secondary)",
          "fontWeight": "600",
          "letterSpacing": "0.08em",
          "textTransform": "uppercase",
          "fontSize": "var(--wp--preset--font-size--sm)"
        },
        "color": {
          "text": "var(--wp--preset--color--neutral-600)"
        }
      },
      "link": {
        "color": {
          "text": "var(--wp--preset--color--secondary)"
        },
        ":hover": {
          "color": {
            "text": "var(--wp--preset--color--accent)"
          }
        }
      },
      "button": {
        "color": {
          "background": "var(--wp--preset--color--accent)",
          "text": "var(--wp--preset--color--white)"
        },
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--secondary)",
          "fontWeight": "600",
          "letterSpacing": "0.05em",
          "fontSize": "var(--wp--preset--font-size--sm)"
        },
        "border": {
          "radius": "4px"
        },
        ":hover": {
          "color": {
            "background": "var(--wp--preset--color--primary)",
            "text": "var(--wp--preset--color--accent)"
          }
        }
      }
    }
  }
}
