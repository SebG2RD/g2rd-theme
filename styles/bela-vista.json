{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"title": "Bela Vista",
	"description": "Variation de style exclusive au programme « Les Jardins Bela Vista » (2APP, Gaillon). Charte pétrole & ciel extraite de la plaquette commerciale. À déposer dans g2rd-theme/styles/bela-vista.json.",
	"settings": {
		"appearanceTools": true,
		"layout": {
			"contentSize": "760px",
			"wideSize": "1200px"
		},
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"custom": true,
			"palette": [
				{ "slug": "petrol", "name": "Bleu pétrole", "color": "#005078" },
				{ "slug": "petrol-dark", "name": "Pétrole foncé", "color": "#003A56" },
				{ "slug": "petrol-light", "name": "Pétrole clair", "color": "#1E6E96" },
				{ "slug": "sky", "name": "Ciel", "color": "#C6E7FA" },
				{ "slug": "sky-soft", "name": "Ciel doux", "color": "#E8F4FB" },
				{ "slug": "ink", "name": "Encre", "color": "#12333F" },
				{ "slug": "muted", "name": "Gris ardoise", "color": "#4A6470" },
				{ "slug": "line", "name": "Filet", "color": "#D9E6EE" },
				{ "slug": "off-white", "name": "Blanc cassé", "color": "#FAFAFA" },
				{ "slug": "base", "name": "Blanc", "color": "#FFFFFF" },
				{ "slug": "coral", "name": "Corail (accent fiscal)", "color": "#E4572E" },
				{ "slug": "green", "name": "Vert (au vert)", "color": "#3F7D5A" }
			],
			"gradients": [
				{
					"slug": "sky-fade",
					"name": "Dégradé ciel",
					"gradient": "linear-gradient(180deg, #E8F4FB 0%, #FFFFFF 100%)"
				},
				{
					"slug": "petrol-deep",
					"name": "Dégradé pétrole",
					"gradient": "linear-gradient(135deg, #005078 0%, #003A56 100%)"
				}
			]
		},
		"typography": {
			"fluid": true,
			"customFontSize": true,
			"lineHeight": true,
			"fontFamilies": [
				{
					"slug": "poppins",
					"name": "Poppins",
					"fontFamily": "Poppins, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif"
				},
				{
					"slug": "script",
					"name": "Dancing Script",
					"fontFamily": "'Dancing Script', 'Segoe Script', 'Brush Script MT', cursive"
				}
			],
			"fontSizes": [
				{ "slug": "small", "name": "Petit", "size": "0.875rem", "fluid": false },
				{ "slug": "medium", "name": "Moyen", "size": "1rem", "fluid": false },
				{ "slug": "large", "name": "Grand", "size": "1.25rem", "fluid": { "min": "1.125rem", "max": "1.375rem" } },
				{ "slug": "x-large", "name": "Très grand", "size": "2rem", "fluid": { "min": "1.6rem", "max": "2.25rem" } },
				{ "slug": "xx-large", "name": "Titre", "size": "3rem", "fluid": { "min": "2.2rem", "max": "3.4rem" } }
			]
		},
		"spacing": {
			"units": ["px", "em", "rem", "%", "vh", "vw"],
			"spacingScale": { "steps": 0 },
			"spacingSizes": [
				{ "slug": "20", "name": "Petit", "size": "clamp(1rem, 2vw, 1.5rem)" },
				{ "slug": "40", "name": "Moyen", "size": "clamp(1.5rem, 4vw, 3rem)" },
				{ "slug": "60", "name": "Grand", "size": "clamp(3rem, 7vw, 6rem)" }
			]
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--base)",
			"text": "var(--wp--preset--color--ink)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--poppins)",
			"fontSize": "var(--wp--preset--font-size--medium)",
			"lineHeight": "1.65"
		},
		"elements": {
			"heading": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--poppins)",
					"fontWeight": "700",
					"lineHeight": "1.15"
				},
				"color": { "text": "var(--wp--preset--color--petrol)" }
			},
			"h1": {
				"typography": { "fontSize": "var(--wp--preset--font-size--xx-large)", "letterSpacing": "-0.01em" }
			},
			"h2": {
				"typography": { "fontSize": "var(--wp--preset--font-size--x-large)" }
			},
			"link": {
				"color": { "text": "var(--wp--preset--color--petrol)" },
				":hover": { "color": { "text": "var(--wp--preset--color--petrol-dark)" } }
			},
			"button": {
				"color": {
					"background": "var(--wp--preset--color--petrol)",
					"text": "var(--wp--preset--color--base)"
				},
				"typography": { "fontWeight": "600" },
				"border": { "radius": "999px" },
				"spacing": {
					"padding": { "top": "0.85rem", "bottom": "0.85rem", "left": "1.6rem", "right": "1.6rem" }
				},
				":hover": {
					"color": { "background": "var(--wp--preset--color--petrol-dark)", "text": "var(--wp--preset--color--base)" }
				},
				":focus": {
					"color": { "background": "var(--wp--preset--color--petrol-dark)", "text": "var(--wp--preset--color--base)" }
				}
			}
		},
		"blocks": {
			"core/site-title": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--script)",
					"fontSize": "var(--wp--preset--font-size--x-large)",
					"fontWeight": "700"
				},
				"color": { "text": "var(--wp--preset--color--petrol)" }
			},
			"core/quote": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--script)",
					"fontSize": "var(--wp--preset--font-size--large)"
				},
				"color": { "text": "var(--wp--preset--color--green)" }
			},
			"core/pullquote": {
				"typography": { "fontFamily": "var(--wp--preset--font-family--script)" },
				"color": { "text": "var(--wp--preset--color--green)" }
			}
		}
	}
}
