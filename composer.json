{
  "name": "g2rd/g2rd-theme",
  "description": "Thème WordPress G2RD — dépendances PHP (coloration syntaxique du bloc code)",
  "license": "EUPL-1.2",
  "require": {
    "php": ">=8.0",
    "scrivo/highlight.php": "^9.0"
  },
  "require-dev": {
    "wp-coding-standards/wpcs": "^3.0",
    "phpcompatibility/phpcompatibility-wp": "^2.1",
    "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
    "phpstan/phpstan": "^2.1",
    "szepeviktor/phpstan-wordpress": "^2.0",
    "phpunit/phpunit": "^10.0"
  },
  "autoload": {
    "psr-4": {
      "G2RD\\": "classes/"
    },
    "classmap": [
      "classes/"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "G2RD\\Tests\\": "tests/phpunit/"
    }
  },
  "extra": {
    "g2rd_theme_version": "1.24.6"
  },
  "config": {
    "optimize-autoloader": true,
    "sort-packages": true,
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    }
  },
  "scripts": {
    "phpcs": "phpcs --standard=phpcs.xml.dist",
    "phpcs:security": "phpcs --standard=phpcs-security.xml --extensions=php --ignore=vendor/*,node_modules/*,blocks/*/build/*,assets/js/vendor/*,.claude/* .",
    "phpcs:compat": "phpcs --standard=PHPCompatibilityWP --extensions=php --ignore=vendor/*,node_modules/*,.claude/* --runtime-set testVersion 8.0- .",
    "phpstan": "phpstan analyse --memory-limit=-1 --no-progress",
    "phpunit": "phpunit --configuration phpunit.xml.dist",
    "test:php": "@phpunit"
  }
}
