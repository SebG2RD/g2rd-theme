{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "apiVersion": 3,
    "name": "g2rd/progress-bar",
    "version": "1.0.0",
    "title": "G2RD Barre de progression",
    "category": "g2rd-blocks",
    "description": "Affiche une barre de progression (linéaire ou circulaire). Utile pour notes d’avis, pourcentages. Valeur fixe ou dynamique depuis un champ de métadonnées (contexte Requête). Design modifiable.",
    "keywords": [
        "progress",
        "bar",
        "progression",
        "note",
        "rating",
        "pourcentage"
    ],
    "attributes": {
        "value": {
            "type": "number",
            "default": 75
        },
        "max": {
            "type": "number",
            "default": 100
        },
        "label": {
            "type": "string",
            "default": ""
        },
        "styleVariant": {
            "type": "string",
            "default": "bar"
        },
        "showPercentage": {
            "type": "boolean",
            "default": true
        },
        "valueSource": {
            "type": "string",
            "default": "static"
        },
        "valueMetaKey": {
            "type": "string",
            "default": ""
        },
        "barColor": {
            "type": "string",
            "default": ""
        },
        "trackColor": {
            "type": "string",
            "default": ""
        }
    },
    "example": {
        "attributes": {
            "value": 85,
            "styleVariant": "circle",
            "label": "Satisfaction"
        }
    },
    "supports": {
        "html": false,
        "align": true,
        "color": {
            "background": true,
            "text": true
        },
        "spacing": {
            "margin": true,
            "padding": true
        }
    },
    "textdomain": "g2rd",
    "render": "file:./render.php",
    "editorScript": "file:./index.js",
    "editorStyle": "file:./index.css",
    "style": "file:./style-index.css"
}
