{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "g2rd/container",
  "version": "1.0.0",
  "title": "Conteneur G2RD",
  "category": "g2rd-blocks",
  "description": "Bloc conteneur responsive : layouts Flex, Grille, Contraint et Flux avec espacement, fond, bordure et animation par appareil.",
  "icon": { "src": "layout", "foreground": "#FAFAFA", "background": "#2F425D" },
  "textdomain": "g2rd",
  "render": "file:./render.php",
  "supports": {
    "html": false,
    "align": ["wide", "full"],
    "color": false,
    "spacing": false,
    "dimensions": false
  },
  "attributes": {
    "blockId":             { "type": "string",  "default": "" },
    "htmlTag":             { "type": "string",  "default": "div" },
    "layoutType":          { "type": "string",  "default": "flex" },

    "flexDirection":       { "type": "string",  "default": "row" },
    "flexDirectionTablet": { "type": "string",  "default": "row" },
    "flexDirectionMobile": { "type": "string",  "default": "column" },
    "flexJustify":         { "type": "string",  "default": "flex-start" },
    "flexJustifyTablet":   { "type": "string",  "default": "" },
    "flexJustifyMobile":   { "type": "string",  "default": "" },
    "flexAlign":           { "type": "string",  "default": "stretch" },
    "flexAlignTablet":     { "type": "string",  "default": "" },
    "flexAlignMobile":     { "type": "string",  "default": "" },
    "flexWrap":            { "type": "boolean", "default": true },
    "flexWrapTablet":      { "type": "boolean", "default": true },
    "flexWrapMobile":      { "type": "boolean", "default": true },
    "flexGap":             { "type": "string",  "default": "20px" },
    "flexGapTablet":       { "type": "string",  "default": "" },
    "flexGapMobile":       { "type": "string",  "default": "" },

    "gridColumns":         { "type": "integer", "default": 2 },
    "gridColumnsTablet":   { "type": "integer", "default": 2 },
    "gridColumnsMobile":   { "type": "integer", "default": 1 },
    "gridGap":             { "type": "string",  "default": "20px" },
    "gridGapTablet":       { "type": "string",  "default": "" },
    "gridGapMobile":       { "type": "string",  "default": "" },

    "constrainedWidth":    { "type": "string",  "default": "1200px" },
    "minHeight":           { "type": "string",  "default": "" },
    "width":               { "type": "string",  "default": "" },

    "paddingTop":          { "type": "string",  "default": "" },
    "paddingRight":        { "type": "string",  "default": "" },
    "paddingBottom":       { "type": "string",  "default": "" },
    "paddingLeft":         { "type": "string",  "default": "" },
    "paddingTopTablet":    { "type": "string",  "default": "" },
    "paddingRightTablet":  { "type": "string",  "default": "" },
    "paddingBottomTablet": { "type": "string",  "default": "" },
    "paddingLeftTablet":   { "type": "string",  "default": "" },
    "paddingTopMobile":    { "type": "string",  "default": "" },
    "paddingRightMobile":  { "type": "string",  "default": "" },
    "paddingBottomMobile": { "type": "string",  "default": "" },
    "paddingLeftMobile":   { "type": "string",  "default": "" },
    "marginTop":           { "type": "string",  "default": "" },
    "marginBottom":        { "type": "string",  "default": "" },

    "bgType":              { "type": "string",  "default": "none" },
    "bgColor":             { "type": "string",  "default": "" },
    "bgGradient":          { "type": "string",  "default": "" },
    "bgImageUrl":          { "type": "string",  "default": "" },
    "bgImageId":           { "type": "integer", "default": 0 },
    "bgImageSize":         { "type": "string",  "default": "cover" },
    "bgImagePosition":     { "type": "string",  "default": "center center" },
    "bgImageRepeat":       { "type": "string",  "default": "no-repeat" },
    "bgOverlay":           { "type": "boolean", "default": false },
    "bgOverlayColor":      { "type": "string",  "default": "rgba(0,0,0,0.5)" },

    "borderRadius":        { "type": "string",  "default": "" },
    "borderWidth":         { "type": "string",  "default": "" },
    "borderStyle":         { "type": "string",  "default": "solid" },
    "borderColor":         { "type": "string",  "default": "" },
    "overflow":            { "type": "string",  "default": "visible" },

    "hideOnMobile":        { "type": "boolean", "default": false },
    "hideOnTablet":        { "type": "boolean", "default": false },
    "hideOnDesktop":       { "type": "boolean", "default": false },

    "animation":           { "type": "string",  "default": "none" },
    "animationDelay":      { "type": "integer", "default": 0 },
    "animationDuration":   { "type": "integer", "default": 600 },
    "animationEasing":     { "type": "string",  "default": "ease" },

    "customCSSClass":      { "type": "string",  "default": "" }
  },
  "editorScript": "file:./build/index.js",
  "editorStyle":  "file:./build/index.css",
  "style":        "file:./style.css"
}
