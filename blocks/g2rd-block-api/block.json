{
  "$schema": "https://schemas.wp.org/wp/6.6/block.json",
  "apiVersion": 3,
  "name": "g2rd/block-api",
  "version": "1.0.0",
  "title": "G2RD Block API",
  "category": "g2rd-blocks",
  "icon": { "src": "rest-api", "foreground": "#FAFAFA", "background": "#2F425D" },
  "description": "Connectez vos blocs à une API externe. Supporte les connecteurs côté serveur (proxy WP) et côté client (fetch JS), avec chargement Ajax, mode chat et streaming.",
  "keywords": ["api", "rest", "fetch", "dynamique", "données", "externe", "json"],
  "supports": {
    "html": false,
    "align": ["wide", "full"],
    "spacing": { "margin": true, "padding": true },
    "color": { "background": true, "text": true }
  },
  "textdomain": "g2rd",
  "editorScript": "file:./build/index.js",
  "editorStyle": "file:./build/index.css",
  "style": "file:./build/style-index.css",
  "viewScript": "file:./build/view.js",
  "attributes": {
    "connectorType": { "type": "string", "default": "client" },
    "apiUrl": { "type": "string", "default": "" },
    "apiMethod": { "type": "string", "default": "GET" },
    "apiHeaders": { "type": "array", "default": [] },
    "apiBody": { "type": "string", "default": "" },
    "responseField": { "type": "string", "default": "" },
    "singleItem": { "type": "boolean", "default": false },
    "enableAjax": { "type": "boolean", "default": false },
    "ajaxTrigger": { "type": "string", "default": "interaction" },
    "formSelector": { "type": "string", "default": "" },
    "customInteractionId": { "type": "string", "default": "" },
    "intervalTime": { "type": "number", "default": 5000 },
    "intervalCount": { "type": "number", "default": 0 },
    "customLoaderSelector": { "type": "string", "default": "" },
    "paginationSelector": { "type": "string", "default": "" },
    "enableChat": { "type": "boolean", "default": false },
    "enableStreaming": { "type": "boolean", "default": false },
    "chatAddField": { "type": "string", "default": "messages" },
    "chatUserFormat": { "type": "string", "default": "" },
    "chatAssistantFormat": { "type": "string", "default": "" },
    "chatResponseField": { "type": "string", "default": "" },
    "resultMappings": { "type": "array", "default": [] },
    "resultsContainerClass": { "type": "string", "default": "" },
    "templateContainerClass": { "type": "string", "default": "" },
    "blockId": { "type": "string", "default": "" }
  }
}
