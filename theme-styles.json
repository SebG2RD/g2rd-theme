{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "styles": {
    "blocks": {
      "core/group": {
        "spacing": {
          "margin": {
            "top": "0 !important"
          }
        },
        "variations": {
          "section-dark": {
            "color": {
              "background": "var:preset|color|primary",
              "text": "var:preset|color|white"
            },
            "spacing": {
              "padding": {
                "top": "var:preset|spacing|xl",
                "bottom": "var:preset|spacing|xl",
                "left": "var:preset|spacing|m",
                "right": "var:preset|spacing|m"
              }
            },
            "elements": {
              "link": {
                "color": {
                  "text": "var:preset|color|secondary"
                }
              }
            }
          },
          "card": {
            "color": {
              "background": "var:preset|color|white"
            },
            "border": {
              "color": "var:custom|color|border",
              "width": "1px",
              "radius": "var:custom|radius|l"
            },
            "spacing": {
              "padding": {
                "top": "var:preset|spacing|m",
                "bottom": "var:preset|spacing|m",
                "left": "var:preset|spacing|m",
                "right": "var:preset|spacing|m"
              }
            },
            "shadow": "var:preset|shadow|light"
          },
          "card-dark": {
            "color": {
              "background": "var:preset|color|primary",
              "text": "var:preset|color|white"
            },
            "border": {
              "radius": "var:custom|radius|l"
            },
            "spacing": {
              "padding": {
                "top": "var:preset|spacing|m",
                "bottom": "var:preset|spacing|m",
                "left": "var:preset|spacing|m",
                "right": "var:preset|spacing|m"
              }
            },
            "shadow": "var:preset|shadow|huge",
            "elements": {
              "link": {
                "color": {
                  "text": "var:preset|color|secondary"
                }
              }
            }
          },
          "card-action": {
            "color": {
              "gradient": "var:preset|gradient|secondary",
              "text": "var:preset|color|white"
            },
            "border": {
              "radius": "var:custom|radius|l"
            },
            "spacing": {
              "padding": {
                "top": "var:preset|spacing|m",
                "bottom": "var:preset|spacing|m",
                "left": "var:preset|spacing|m",
                "right": "var:preset|spacing|m"
              }
            },
            "shadow": "var:preset|shadow|accent-glow"
          }
        }
      },
      "core/template-part": {
        "spacing": {
          "margin": {
            "top": "0 !important"
          }
        }
      },
      "core/image": {
        "border": {
          "radius": "var:custom|radius|s"
        }
      },
      "g2rd/countdown": {
        "color": {
          "background": "var(--wp--preset--color--white)",
          "text": "var(--wp--preset--color--primary)"
        },
        "spacing": {
          "margin": {
            "top": "var(--wp--preset--spacing--m)",
            "bottom": "var(--wp--preset--spacing--m)"
          },
          "padding": {
            "top": "var(--wp--preset--spacing--s)",
            "bottom": "var(--wp--preset--spacing--s)",
            "left": "var(--wp--preset--spacing--s)",
            "right": "var(--wp--preset--spacing--s)"
          }
        },
        "typography": {
          "fontSize": "var(--wp--preset--font-size--m)",
          "fontFamily": "var(--wp--preset--font-family--inter)",
          "fontWeight": "400",
          "lineHeight": "1.5"
        },
        "border": {
          "radius": "var(--wp--custom--radius--m)",
          "width": "1px",
          "style": "solid",
          "color": "var(--wp--preset--color--secondary)"
        },
        "shadow": "var(--wp--preset--shadow--light)"
      },
      "core/button": {
        "variations": {
          "outline": {
            "border": {
              "color": "var:custom|color|border",
              "width": "1px",
              "radius": "var:custom|radius|s"
            },
            "color": {
              "background": "transparent",
              "text": "var:preset|color|primary"
            },
            "spacing": {
              "padding": {
                "top": "var:preset|spacing|xs",
                "right": "var:preset|spacing|xs",
                "bottom": "var:preset|spacing|xs",
                "left": "var:preset|spacing|xs"
              }
            },
            "typography": {
              "fontWeight": "var:custom|font-weight|semibold"
            }
          },
          "action": {
            "color": {
              "gradient": "var:preset|gradient|secondary",
              "text": "var:preset|color|white"
            },
            "border": {
              "radius": "var:custom|radius|s",
              "width": "0"
            },
            "typography": {
              "fontWeight": "var:custom|font-weight|semibold"
            }
          },
          "ghost": {
            "color": {
              "background": "transparent",
              "text": "var:preset|color|primary"
            },
            "border": {
              "radius": "var:custom|radius|s",
              "width": "0"
            },
            "typography": {
              "fontWeight": "var:custom|font-weight|semibold"
            }
          }
        }
      },
      "core/separator": {
        "color": {
          "text": "var:custom|color|border"
        }
      },
      "core/quote": {
        "border": {
          "left": {
            "color": "var:preset|color|secondary",
            "width": "4px"
          }
        },
        "spacing": {
          "padding": {
            "left": "var:preset|spacing|s"
          }
        },
        "color": {
          "text": "var:preset|color|primary"
        }
      },
      "core/pullquote": {
        "border": {
          "top": {
            "color": "var:preset|color|secondary",
            "width": "3px"
          },
          "bottom": {
            "color": "var:preset|color|secondary",
            "width": "3px"
          }
        },
        "color": {
          "text": "var:preset|color|primary"
        }
      },
      "core/table": {
        "border": {
          "color": "var:custom|color|border",
          "width": "1px",
          "radius": "var:custom|radius|m"
        }
      },
      "core/code": {
        "color": {
          "background": "var:preset|color|surface"
        },
        "border": {
          "radius": "var:custom|radius|s"
        },
        "spacing": {
          "padding": {
            "top": "var:preset|spacing|xs",
            "right": "var:preset|spacing|xs",
            "bottom": "var:preset|spacing|xs",
            "left": "var:preset|spacing|xs"
          }
        },
        "typography": {
          "fontFamily": "ui-monospace, SFMono-Regular, Menlo, Consolas, monospace"
        }
      }
    },
    "color": {
      "text": "var:preset|color|primary",
      "background": "var:preset|color|white"
    },
    "spacing": {
      "blockGap": "var:preset|spacing|s",
      "padding": {
        "top": "0",
        "right": "var:preset|spacing|s",
        "bottom": "0",
        "left": "var:preset|spacing|s"
      }
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--inter)",
      "fontSize": "var:preset|font-size|m",
      "fontWeight": "var:custom|font-weight|regular",
      "lineHeight": "var:custom|line-height|regular"
    },
    "elements": {
      "h1": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--plus-jakarta-sans)",
          "fontSize": "var:preset|font-size|xl",
          "fontWeight": "var:custom|font-weight|bold"
        }
      },
      "h2": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--plus-jakarta-sans)",
          "fontSize": "var:preset|font-size|l",
          "fontWeight": "var:custom|font-weight|bold"
        }
      },
      "h3": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--inter)",
          "fontSize": "var:preset|font-size|m"
        }
      },
      "h4": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--inter)",
          "fontSize": "var:preset|font-size|s"
        }
      },
      "h5": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--inter)",
          "fontSize": "var:preset|font-size|xs"
        }
      },
      "h6": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--inter)",
          "fontSize": "var:preset|font-size|xs"
        }
      },
      "link": {
        "color": {
          "text": "var:custom|color|accenthover"
        }
      },
      "caption": {
        "color": {
          "text": "var:preset|color|muted"
        },
        "typography": {
          "fontSize": "var:preset|font-size|s"
        }
      },
      "button": {
        "css": "transition: .2s cubic-bezier(0.16, 1, 0.3, 1) all;",
        "border": {
          "radius": "var:custom|radius|s",
          "width": "0"
        },
        "shadow": "var:preset|shadow|secondary-glow",
        "color": {
          "background": "var:preset|color|secondary",
          "text": "var:preset|color|primary"
        },
        "spacing": {
          "padding": {
            "top": "var:preset|spacing|xs",
            "right": "var:preset|spacing|xs",
            "bottom": "var:preset|spacing|xs",
            "left": "var:preset|spacing|xs"
          }
        },
        "typography": {
          "fontSize": "var:preset|font-size|m",
          "fontWeight": "var:custom|font-weight|semibold"
        },
        ":hover": {
          "shadow": "var:preset|shadow|neat",
          "color": {
            "background": "var:custom|color|secondaryhover",
            "text": "var:preset|color|primary"
          }
        }
      }
    }
  }
}
