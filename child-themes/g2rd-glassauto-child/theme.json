    "custom": {
      "radius": {
        "pill": "999px",
        "card": "4px",
        "input": "4px"
      },
      "pente": "0.643",
      "corner": "44px",
      "headerHeight": "5.5rem",
      "duree": "300ms",
      "ease": "cubic-bezier(0.2, 0.7, 0.2, 1)",
      "tracking": {
        "label": "0.18em",
        "titre": "-0.025em",
        "display": "-0.04em"
      },
      "button": {
        "radius": "999px",
        "radius-pill": "999px",
        "radius-square": "4px",
        "padding-h": "1.5rem",
        "padding-v": "0.75rem",
        "font-weight": 700,
        "transition": "300ms cubic-bezier(0.2, 0.7, 0.2, 1)"
      },
      "color": {
        "primaryhover": "#494949",
        "secondaryhover": "#2CAEC4",
        "whitehover": "#F6F6F6",
        "accenthover": "#C8003E",
        "border": "#F0F0F0"
      }
    },
    "blocks": {
      "core/button": {
        "border": {
          "radius": true
        },
        "shadow": {
          "defaultPresets": false
        }
      },
      "core/image": {
        "lightbox": {
          "enabled": false,
          "allowEditing": true
        }
      }
    }
