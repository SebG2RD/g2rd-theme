        {
          "slug": "xl",
          "name": "Titre 2 (28 → 44 px)",
          "size": "clamp(1.75rem, 1.35rem + 1.6vw, 2.75rem)"
        },
        {
          "slug": "xxl",
          "name": "Titre 1 (34 → 56 px)",
          "size": "clamp(2.125rem, 1.6rem + 2.2vw, 3.5rem)"
        },
        {
          "slug": "display",
          "name": "Display (40 → 72 px)",
          "size": "clamp(2.5rem, 1.6rem + 3.6vw, 4.5rem)"
