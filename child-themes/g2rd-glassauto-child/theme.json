    "shadow": {
      "defaultPresets": false,
      "presets": [
        {
          "slug": "douce",
          "name": "Douce",
          "shadow": "0 4px 20px rgba(47, 50, 55, 0.10)"
        },
        {
          "slug": "carte",
          "name": "Carte",
          "shadow": "0 12px 40px rgba(47, 50, 55, 0.16)"
        },
        {
          "slug": "menu",
          "name": "Menu",
          "shadow": "0 16px 64px rgba(47, 50, 55, 0.24)"
        },
        {
          "slug": "aucune",
          "name": "Aucune",
          "shadow": "none"
        }
      ]
