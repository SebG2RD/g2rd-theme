          "name": "Mention (13 px)",
          "size": "0.8125rem"
        },
        {
          "slug": "s",
          "name": "Petit (15 px)",
          "size": "0.9375rem"
        },
        {
          "slug": "m",
          "name": "Texte (17 px)",
          "size": "1.0625rem"
        },
        {
          "slug": "l",
          "name": "Chapô (17 → 20 px)",
          "size": "clamp(1.0625rem, 1rem + 0.3vw, 1.25rem)"
