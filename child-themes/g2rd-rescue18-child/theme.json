        },
        {
          "slug": "xs",
          "name": "Mention (12 px)",
          "size": "0.75rem"
        },
        {
          "slug": "s",
          "name": "Petit (14 px)",
          "size": "0.875rem"
        },
        {
          "slug": "m",
          "name": "Texte (16 px)",
          "size": "1rem"
        },
        {
          "slug": "l",
          "name": "Chapô (18 → 21 px)",
          "size": "clamp(1.125rem, 1.05rem + 0.35vw, 1.3125rem)"
        },
        {
          "slug": "h3",
          "name": "Titre 3 (20 → 24 px)",
          "size": "clamp(1.25rem, 1.15rem + 0.4vw, 1.5rem)"
        },
        {
          "slug": "xl",
          "name": "Titre 2 (34 → 62 px)",
          "size": "clamp(2.125rem, 1.2rem + 3.4vw, 3.875rem)"
        },
        {
          "slug": "xxl",
          "name": "Titre 1 (40 → 74 px)",
          "size": "clamp(2.5rem, 1.4rem + 3.8vw, 4.625rem)"
        },
        {
          "slug": "display",
          "name": "Display hero (50 → 112 px)",
          "size": "clamp(3.125rem, 7.15vw, 7rem)"
        }
      ]
