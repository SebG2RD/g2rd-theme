        {
          "slug": "inter",
          "name": "Inter (charte Rescue 18)",
          "fontFamily": "Inter, ui-sans-serif, system-ui, -apple-system, \"Segoe UI\", sans-serif",
          "fontFace": [
            {
              "fontFamily": "Inter",
              "fontStyle": "normal",
              "fontWeight": "100 900",
              "fontDisplay": "swap",
              "src": [
                "file:./assets/fonts/inter-var.woff2"
              ]
            }
          ]
        }
      ],
      "fontSizes": [
        {
          "slug": "label",
          "name": "Surtitre (11 px)",
