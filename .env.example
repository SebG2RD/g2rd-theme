# URL de base du site WordPress local (Local by Flywheel, Laragon, etc.)
# Copier ce fichier en .env et adapter l'URL
PLAYWRIGHT_BASE_URL=http://g2rd.local

# Pages contenant les blocs à tester (chemins relatifs depuis PLAYWRIGHT_BASE_URL)
# Créer ces pages dans WordPress avec les blocs correspondants, puis renseigner leurs slugs
PLAYWRIGHT_HERO_PAGE=/
PLAYWRIGHT_CAROUSEL_PAGE=/demo-carousel
PLAYWRIGHT_FAQ_PAGE=/demo-faq
